# Intuit Developer Portal: choose Sandbox for testing; Production only after app approval.
BIZBETTER_QBO_ENV=sandbox
BIZBETTER_QBO_CLIENT_ID=
BIZBETTER_QBO_CLIENT_SECRET=
BIZBETTER_QBO_REDIRECT_URI=http://127.0.0.1:3000/api/integrations/qbo/callback
# Generate 32 random bytes and base64 encode them. Back this key up securely.
BIZBETTER_SECRET_ENCRYPTION_KEY=
# Legacy manual Stripe key remains server-only; never enter it in the browser.
BIZBETTER_STRIPE_SECRET_KEY=

# Optional server-only analyst. Without the key, deterministic analysis remains available.
OPENAI_API_KEY=
# Optional xAI API key. Select grok below to route analysis to xAI.
XAI_API_KEY=
# Choose openai, grok or gemini. OpenAI remains the default.
BIZBETTER_AI_PROVIDER=openai
BIZBETTER_AI_FAST_MODEL=gpt-4.1-mini
BIZBETTER_AI_DEEP_MODEL=gpt-4.1
# Optional Grok model override. Defaults to grok-4.7.
BIZBETTER_AI_GROK_MODEL=
# Optional single model override for all depths:
BIZBETTER_AI_MODEL=

# Google AI Studio key, server-only. Use synthetic data for unpaid-tier testing.
GEMINI_API_KEY=
BIZBETTER_AI_GEMINI_MODEL=gemini-3.1-flash-lite
